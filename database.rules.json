{
  "rules": {
    "queue": {
      "$queue": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "!newData.exists() || (newData.child('name').isString() && newData.child('name').val().length <= 24 && newData.child('at').isNumber())"
        }
      }
    },
    "liveMatches": {
      "$match": {
        ".read": "auth != null && data.child('memberIds').child(auth.uid).val() === true",
        ".write": "auth != null && newData.child('hostId').val() === auth.uid && newData.child('memberIds').child(auth.uid).val() === true && (!data.exists() || data.child('hostId').val() === auth.uid)",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('liveMatches').child($match).child('memberIds').child(auth.uid).val() === true"
          }
        },
        "events": {
          "$event": {
            ".write": "auth != null && !data.exists() && newData.child('from').val() === auth.uid && root.child('liveMatches').child($match).child('memberIds').child(auth.uid).val() === true"
          }
        }
      }
    },
    "drafts": {
      "$match": {
        ".read": "auth != null && data.child('memberIds').child(auth.uid).val() === true",
        ".write": "auth != null && newData.child('hostId').val() === auth.uid && newData.child('memberIds').child(auth.uid).val() === true && (!data.exists() || data.child('hostId').val() === auth.uid)",
        "picks": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('drafts').child($match).child('memberIds').child(auth.uid).val() === true"
          }
        }
      }
    }
  }
}
